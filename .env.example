# Copy to .env and fill in. Never commit the real .env.
#
# The /agents API is DEV-ONLY. A prod endpoint (api.u1.archetypeai.app) returns
# 404 for every /agents path, which reads like an unregistered blueprint rather
# than the wrong host — so if blueprints look missing, check this line first.
ATAI_API_KEY=<dev API key>
ATAI_API_ENDPOINT=https://api.dev.u1.archetypeai.app
