# Copy to .env and fill in. Never commit the real .env.
#
# The platform.* endpoints end in /api: /agents is at <endpoint>/agents and the
# files API at <endpoint>/files. The legacy api.* hosts (e.g.
# https://api.dev.u1.archetypeai.app) served files under /v0.5 instead;
# tva_api.files_root() handles both.
ATAI_API_KEY=<API key>
ATAI_API_ENDPOINT=https://platform.u1.archetypeai.app/api
