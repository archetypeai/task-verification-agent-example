# Secrets: never commit.
.env
.env.*
!.env.example

# Generated SOP copies, written only when a SOP file needs normalising.
data/*.txt

# The clips in data/clips/ are committed: recorded for this example, 80 MB in all.

# Run outputs, regenerated by the scripts. reference/ holds the committed copies.
/tva-output*
/*.jsonl
eval_*/
data/clips-serving/
logs/

# Lifecycle 2.0 ids: the project, copies, packages, deployments and sessions
state/
state-*/

# Python
__pycache__/
*.py[cod]
.venv/

.DS_Store
.claude/settings.local.json
